---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import StoryCard from '../../components/StoryCard.astro';
import { href } from '../../lib/site';
export async function getStaticPaths() { return (await getCollection('daily')).map((entry) => ({ params: { slug: entry.id }, props: { entry } })); }
const { entry } = Astro.props;
---
<Base title={entry.data.title} description={entry.data.summary}><div class="page-intro wrap"><div class="section-kicker">DAILY SIGNAL / {entry.data.date}</div><h1>{entry.data.title}</h1><p>{entry.data.summary}</p><a class="back-link" href={href('archive/')}>← 返回日报归档</a></div><div class="wrap story-list issue-page">{entry.data.items.map((item, i) => <StoryCard item={item} index={i} />)}</div></Base>
